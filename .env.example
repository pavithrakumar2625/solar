# ==================================================
# SolarRecover AI — Environment Configuration
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==================================================

# ---- Application ----
APP_NAME=SolarRecover AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# ---- Backend Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SolarRecover AI

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://solarrecover:solarrecover@localhost:5432/solarrecover
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ---- Redis (optional, not required for MVP) ----
# REDIS_URL=redis://localhost:6379/0

# ---- Authentication ----
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AI / LLM Provider ----
# Supported: gemini, openai
AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
AI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3

# ---- Weather Provider ----
# Supported: open_meteo, openweathermap
WEATHER_PROVIDER=open_meteo
# OPENWEATHERMAP_API_KEY=your_key_here

# ---- File Storage ----
# Supported: local, s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- Email (optional) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@solarrecover.ai

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- ML ----
ML_MODELS_PATH=./ml/models/artifacts
ML_DATA_PATH=./ml/data
